[Unit]
Description=MAGIC Chess Board Game Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=magicpi
Group=magicpi
WorkingDirectory=/home/magicpi/MAGIC---FYP/src/chess_sim
ExecStart=/usr/bin/python3 /home/magicpi/MAGIC---FYP/src/chess_sim/main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
